# Copy to .env and fill in. NEVER commit .env or share it in chat.

# Random long string; send as X-Admin-Token header to admin endpoints
ADMIN_TOKEN=change-me

# Safety: keep true until a test run shows the correct quantities in /stock/pushes
DRY_RUN=true
STOCK_BUFFER=0
POLL_INTERVAL_SECONDS=300

# Dealer portal: "local" = built-in test store, "rest" = Vagmine order flow,
# "api" = send orders to ORDER_API_URL and take stock from POST /api/v1/stock
PORTAL_MODE=api
# Where new Amazon/Flipkart orders are sent (to be provided), and an optional Bearer token for it
ORDER_API_URL=
ORDER_API_TOKEN=
PORTAL_BASE_URL=
# Dealer portal login (POST /api/v1/auth/login). Fill these in yourself; never paste them in chat.
PORTAL_USERNAME=
PORTAL_PASSWORD=
# Change these only if the portal uses different paths/field names
PORTAL_LOGIN_PATH=/api/v1/auth/login
PORTAL_REFRESH_PATH=/api/v1/auth/refresh
PORTAL_USERNAME_FIELD=username
PORTAL_REFRESH_FIELD=refresh_token

# Order flow: resolve customer -> analyze -> push order -> track
# Safety switch: false = resolve/push are blocked, nothing is created on the portal
PORTAL_WRITE_ENABLED=false
# Ids used when a request does not send them (confirm with Shubham which branch marketplace orders belong to)
PORTAL_SOURCE_BRANCH_DEALER_ID=
PORTAL_HOME_BRANCH_DEALER_ID=
PORTAL_ORDER_FOR_USER_ID=
# Tracking endpoint, waiting for docs from Shubham, e.g. /api/v1/PUSH_ORDER/track/{order_reference_no}
PORTAL_TRACK_PATH=
PORTAL_WEBHOOK_SECRET=change-me-too

# Flipkart: Seller Hub > Manage Profile > Developer Access > Self Access (must be Active, not Pending)
FLIPKART_ENABLED=false
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
# Warehouse location id (Seller Hub > Manage Profile > Pickup/Business locations, e.g. LOCxxxxxxxx)
FLIPKART_LOCATION_ID=

# Amazon: Solution Provider Portal > Developer Central
#   LWA credentials > View      -> client id + secret
#   Edit App (v) > Authorize    -> refresh token
#   Seller Central > Settings > Account Info > Merchant Token -> seller id
AMAZON_ENABLED=false
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
